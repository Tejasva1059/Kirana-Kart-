{
  "info": {
    "_postman_id": "c1f7a421-2e11-4777-a89e-2f9b870c918e",
    "name": "Kirna Kart - Customer Authentication API (v1)",
    "description": "Production-grade, security-hardened Customer Authentication and Profile APIs for Kirna Kart.\nFeatures separate automated flows for Signup and Login with OTP verification tickets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "mobileNumber",
      "value": "9876543210",
      "type": "string"
    },
    {
      "key": "signupChallengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "signupVerificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginChallengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginVerificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Flow 1 - Customer Signup",
      "item": [
        {
          "name": "1. Request Signup OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.challengeId) {",
                  "    pm.collectionVariables.set('signupChallengeId', json.data.challengeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "request"]
            },
            "description": "Requests an OTP challenge for customer registration."
          }
        },
        {
          "name": "2. Verify Signup OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.verificationToken) {",
                  "    pm.collectionVariables.set('signupVerificationToken', json.data.verificationToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"signup\",\n  \"challengeId\": \"{{signupChallengeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            },
            "description": "Verifies signup OTP ('123456' accepted in development) and returns one-time signup ticket."
          }
        },
        {
          "name": "3. Customer Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"verificationToken\": \"{{signupVerificationToken}}\",\n  \"acceptedTerms\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "signup"]
            },
            "description": "Creates customer account in MongoDB using signup ticket and issues JWT & refresh tokens."
          }
        }
      ]
    },
    {
      "name": "Flow 2 - Customer Login",
      "item": [
        {
          "name": "1. Request Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.challengeId) {",
                  "    pm.collectionVariables.set('loginChallengeId', json.data.challengeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "request"]
            },
            "description": "Requests an OTP for an existing customer to login."
          }
        },
        {
          "name": "2. Verify Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.verificationToken) {",
                  "    pm.collectionVariables.set('loginVerificationToken', json.data.verificationToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"login\",\n  \"challengeId\": \"{{loginChallengeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            },
            "description": "Verifies login OTP ('123456' accepted in development) and returns one-time login ticket."
          }
        },
        {
          "name": "3. Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"verificationToken\": \"{{loginVerificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "login"]
            },
            "description": "Authenticates existing customer via login ticket and creates an active session."
          }
        }
      ]
    },
    {
      "name": "Flow 3 - Authenticated Profile & Session",
      "item": [
        {
          "name": "1. Get Authenticated Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Fetches profile of currently authenticated customer using JWT."
          }
        },
        {
          "name": "2. Update Customer Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Kumar Sharma\",\n  \"email\": \"rahulkumar.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "me"]
            },
            "description": "Updates approved profile fields. Mobile number updates are strictly rejected."
          }
        },
        {
          "name": "3. Rotate Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token", "refresh"]
            },
            "description": "Rotates refresh token and returns a new access token."
          }
        },
        {
          "name": "4. Logout Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes current session and invalidates refresh token."
          }
        }
      ]
    },
    {
      "name": "Flow 4 - Health & Probes",
      "item": [
        {
          "name": "Liveness Probe (/health)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Readiness Probe (/ready)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            }
          }
        }
      ]
    }
  ]
}

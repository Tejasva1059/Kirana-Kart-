              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.challengeId) {",
                  "    pm.collectionVariables.set('loginChallengeId', json.data.challengeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"purpose\": \"login\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "Requests an OTP for an existing customer to login."
          }
        },
        {
          "name": "2. Verify Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.verificationToken) {",
                  "    pm.collectionVariables.set('loginVerificationToken', json.data.verificationToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"otp\": \"123456\",\n  \"purpose\": \"login\",\n  \"challengeId\": \"{{loginChallengeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Verifies login OTP ('123456' accepted in development) and returns one-time login ticket."
          }
        },
        {
          "name": "3. Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', json.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.tokens.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"{{mobileNumber}}\",\n  \"verificationToken\": \"{{loginVerificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "customer",
                "login"
              ]
            },
            "description": "Authenticates existing customer via login ticket and creates an active session."
          }
        }
      ]
    },
    {
      "name": "Flow 3 - Authenticated Profile & Session",
      "item": [
        {
          "name": "1. Get Authenticated Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Fetches profile of currently authenticated customer using JWT."
          }
        },
        {
          "name": "2. Update Customer Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Kumar Sharma\",\n  \"email\": \"rahulkumar.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers",
                "me"
              ]
            },
            "description": "Updates approved profile fields. Mobile number updates are strictly rejected."
          }
        },
        {
          "name": "3. Rotate Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh"
              ]
            },
            "description": "Rotates refresh token and returns a new access token."
          }
        },
        {
          "name": "4. Logout Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes current session and invalidates refresh token."
          }
        }
      ]
    },
    {
      "name": "Flow 4 - Address Management",
      "item": [
        {
          "name": "1. List Saved Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Lists saved addresses for the authenticated customer. Default address returned first."
          }
        },
        {
          "name": "2. Create Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('addressId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"recipientName\": \"Rahul Sharma\",\n  \"recipientMobile\": \"9876543210\",\n  \"addressLine1\": \"House 12\",\n  \"addressLine2\": \"Near Main Road\",\n  \"landmark\": \"Near Ganesh Temple\",\n  \"locality\": \"Khudel\",\n  \"city\": \"Indore\",\n  \"district\": \"Indore\",\n  \"state\": \"Madhya Pradesh\",\n  \"postalCode\": \"{{postalCode}}\",\n  \"country\": \"India\",\n  \"deliveryInstructions\": \"Call on arrival\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [75.9782, 22.6841]\n  },\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses"
              ]
            },
            "description": "Creates an address for the authenticated customer. Evaluates serviceability and saves addressId to collection variables."
          }
        },
        {
          "name": "3. Fetch One Address",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}"
              ]
            },
            "description": "Fetches a single address by ID. Enforces customer ownership (returns 404 if not owned)."
          }
        },
        {
          "name": "4. Edit Address",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Work\",\n  \"addressLine1\": \"Flat 302, Green Valley Apartments\",\n  \"deliveryInstructions\": \"Leave at security desk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}"
              ]
            },
            "description": "Partially updates an address. Protected fields are rejected, and address changes re-trigger geocoding and serviceability checks."
          }
        },
        {
          "name": "5. Set Default Address",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}",
                "default"
              ]
            },
            "description": "Sets the specified address as default and unsets any previous default atomically."
          }
        },
        {
          "name": "6. Delete Address",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}"
              ]
            },
            "description": "Deletes an address. If the deleted address was default, reassigns default to the most recently updated remaining address."
          }
        }
      ]
    },
    {
      "name": "Flow 5 - Delivery Serviceability",
      "item": [
        {
          "name": "1. Check Serviceability by Saved Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/serviceability/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "serviceability",
                "check"
              ]
            },
            "description": "Evaluates delivery serviceability for a customer's saved address."
          }
        },
        {
          "name": "2. Check Serviceability by Coordinates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"latitude\": 22.6841,\n    \"longitude\": 75.9782\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/serviceability/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "serviceability",
                "check"
              ]
            },
            "description": "Evaluates delivery serviceability directly using GPS coordinates against polygon service boundaries."
          }
        },
        {
          "name": "3. Check Serviceability by Address & PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postalCode\": \"453115\",\n  \"city\": \"Indore\",\n  \"locality\": \"Khudel\",\n  \"location\": {\n    \"latitude\": 22.6841,\n    \"longitude\": 75.9782\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/serviceability/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "serviceability",
                "check"
              ]
            },
            "description": "Pre-check serviceability before saving an address using postal code and coordinates."
          }
        }
      ]
    },
    {
      "name": "Flow 6 - Location Search",
      "item": [
        {
          "name": "1. Search Places & Locations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations/search?q={{query}}&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Searches locations via geocoding provider (Google Places / Mock) and attaches serviceability."
          }
        },
        {
          "name": "2. Search Places with Location Bias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations/search?q={{query}}&latitude={{latitude}}&longitude={{longitude}}&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                },
                {
                  "key": "latitude",
                  "value": "{{latitude}}"
                },
                {
                  "key": "longitude",
                  "value": "{{longitude}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Searches places biased towards user's current GPS position."
          }
        }
      ]
    },
    {
      "name": "Flow 7 - Health & Probes",
      "item": [
        {
          "name": "Liveness Probe (/health)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Readiness Probe (/ready)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          }
        }
      ]
    }
  ]
}
# Application Configuration
APP_NAME=Kirana Kart Authentication API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# MongoDB Configuration
# Local Standalone or Replica Set URI
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=kirana_kart
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
USE_MOCK_DB=false
MONGODB_AUTO_FALLBACK_MOCK=true

# Authentication & JWT Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=kirana-kart-api
JWT_AUDIENCE=kirana-kart-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP & Verification Ticket Security
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=replace-with-a-separate-secure-random-secret
VERIFICATION_TICKET_EXPIRE_SECONDS=300

# SMS Provider Configuration: mock | fast2sms | twilio
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Redis Configuration (Optional in dev/test, recommended for distributed rate limiting in production)
REDIS_URL=

# Geocoding & Location Search Configuration
GEOCODING_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

DEFAULT_COUNTRY=India
DEFAULT_CURRENCY=INR
DEFAULT_DELIVERY_CHARGE=0

SERVICEABILITY_FAIL_CLOSED=true
LOCATION_SEARCH_MIN_QUERY_LENGTH=2
LOCATION_SEARCH_MAX_RESULTS=20
GEOCODING_TIMEOUT_SECONDS=5

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Structured Logging
LOG_LEVEL=INFO
